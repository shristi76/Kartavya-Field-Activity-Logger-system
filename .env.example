# PostgreSQL connection string (PostgreSQL 14+ recommended)
DATABASE_URL=postgresql://field_app:change_this_password@localhost:5432/field_activity

# Generate a long random value for Flask sessions and mobile bearer tokens
SECRET_KEY=replace_with_a_long_random_secret

# Initial administrator account (never exposed in public registration)
ADMIN_WORKER_ID=admin
ADMIN_PASSWORD=1234

# Use true when HTTPS is configured in production
COOKIE_SECURE=false

GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=your_gemini_model
